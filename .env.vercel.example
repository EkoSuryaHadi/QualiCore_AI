# Required Vercel project environment variables
# Use a managed PostgreSQL connection string (Neon, Supabase, or another Postgres provider).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=480
# Same-origin Services routing normally means CORS is not needed by the browser,
# but keep the production domain here for explicit allow-listing.
CORS_ORIGINS=https://quali-core-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# First deploy only: set true to create tables. Turn false after the schema exists.
AUTO_BOOTSTRAP=true
# Optional demo account admin@qualicore.ai / Admin123! for a private demo deployment only.
SEED_DEMO=true

# Do not set NEXT_PUBLIC_BACKEND_URL manually; Vercel Services generates it.
